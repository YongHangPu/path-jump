{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginName": "路径秒开",
  "description": "输入或粘贴路径，秒开文件与文件夹；支持逐级浏览与智能提取。",
  "features": [
    {
      "code": "go",
      "description": "输入 go 或 路径 进入目录浏览",
      "platform": ["win32", "darwin"],
      "cmds": ["go", "路径", "打开路径"]
    },
    {
      "code": "go-path",
      "description": "识别文本中的 Windows 或 macOS 路径并直接打开",
      "platform": ["win32", "darwin"],
      "cmds": [
        {
          "type": "regex",
          "label": "路径秒开",
          "match": "/(?:^|[\\s\"'（(\\[【“‘「=，：、])(?:[A-Za-z]:[\\\\\\/]|~\\/|\\/(?=[^\\s\\/]))[^\\r\\n]*/",
          "minLength": 3,
          "maxLength": 2000
        }
      ]
    }
  ]
}
